# ============================================================
# MovieBox International — environment variables
# Copy to .env.local (dev) or set in your host's dashboard.
# ============================================================

# ---------- Supabase (recommended for production) ----------
# Create a free project at https://supabase.com, run supabase/schema.sql
# in its SQL Editor, then paste the values from Project Settings > API.
# WITHOUT these, the app falls back to a local file store (demo mode).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Admin dashboard (/admin) ----------
# CHANGE THIS before going live!
ADMIN_PASSWORD=moviebox-admin
# Optional extra salt for the session cookie
ADMIN_SECRET=

# ---------- Download funnel ----------
# Direct link to your REAL installer (.exe/.zip). Empty = the bundled
# placeholder /downloads/MovieBox-Setup.zip is served instead.
APP_DOWNLOAD_URL=

# ---------- Content (TMDB) ----------
# Get a free key at https://www.themoviedb.org/settings/api
# A shared demo key is used if omitted.
TMDB_API_KEY=

# ---------- Platform blocklist (optional) ----------
# JSON array of: windows | mobile | mac | chromeos | linux | other
# Defaults to blocking everything except Windows:
# BLOCKED_PLATFORMS=["mobile","mac","chromeos","linux","other"]

# ---------- Local file store (demo mode only) ----------
# DATA_DIR=./data
